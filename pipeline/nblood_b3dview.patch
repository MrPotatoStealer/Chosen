+
+// Blood3D comparison mode (-b3dview x,y,z,yaw,pitch in Quake units, -b3dshot seconds): the view is drawn from that
+// camera (view.cpp) and after that long a screenshot (b3dvNNNN.png) is saved and the game quits. -b3dviews <file>
+// takes a list instead (a line per view: x y z yaw pitch [sector]: the camera's sector, where rooms share space; else
+// the one updatesectorz finds): the first after -b3dshot seconds (default 2), each next
+// one a few frames later, one screenshot each (b3dv0000, b3dv0001, ... in list order), then the game quits. From the
+// first view on the game's logic is held (gB3dHold), so every view shows the same moment (a train, a lift, a door on
+// its timer), as Godot's --views holds its world at the same game time. The
+// weapon, crosshair and status bar are not drawn in this mode.
+bool gB3dView = false;
+double gB3dViewPos[6] = { 0, 0, 0, 0, 0, -1 };
+double gB3dShotSeconds = -1;
+static ClockTicks gB3dStartClock = -1;
+static double gB3dViews[1024][6];
+static int gB3dViewCount = 0, gB3dViewIndex = 0;
+static int gB3dSettle = 0;
+static bool gB3dHold = false;      // a view list from its first view on: ProcessFrame runs no game logic
+bool gB3dFreezeFx = false;      // a view list: sector light effects stay at their base shades (sectorfx.cpp)
+
+// Blood3D test spots (-b3dwarp x,y,z,yaw[,pitch[,sector]] in Quake units, z the feet; godot\playat.bat): an ordinary
+// game, the player put there once the level has started. sector: the Build sector (rooms sharing space); else the one
+// updatesectorz finds.
+static bool gB3dWarp = false;
+static double gB3dWarpPos[6] = { 0, 0, 0, 0, 0, -1 };
+
+// Blood3D: -b3dsend s[,s...] turns those Build sectors on once the level has started (trTriggerSector, as walking
+// in or a switch would), to compare movers mid-motion (with -b3dview and -b3dshot seconds); c<n>: toggles channel n
+// (evSend, as a switch sending it would: E1M2's train); o<n>: turns sector n off (one that starts on)
+static int gB3dSend[16], gB3dSendCount = 0;
+
+static void B3dWarpPlayer(void)
+{
+    spritetype *pSprite = gMe->pSprite;
+    int x = (int)(gB3dWarpPos[0] * 16), y = (int)(-gB3dWarpPos[1] * 16), z = (int)(-gB3dWarpPos[2] * 256);
+    int16_t nSector = pSprite->sectnum;
+    if (gB3dWarpPos[5] >= 0 && gB3dWarpPos[5] < numsectors)
+        nSector = (int)gB3dWarpPos[5];
+    else
+        updatesectorz(x, y, z - 2048, &nSector);
+    if (nSector < 0)
+        return;
+    pSprite->x = x;
+    pSprite->y = y;
+    if (pSprite->sectnum != nSector)
+        ChangeSpriteSect(pSprite->index, nSector);
+    // in an underwater sector: swimming, as crossing its water link would make it (actor.cpp)
+    if (sector[nSector].extra > 0 && xsector[sector[nSector].extra].Underwater)
+    {
+        gMe->pXSprite->medium = kMediumWater;
+        gMe->posture = kPostureSwim;
+    }
+    int top, bottom;
+    GetSpriteExtents(pSprite, &top, &bottom);
+    pSprite->z += z - bottom;
+    int nAng = (int)fmod(-gB3dWarpPos[3] * 2048.0 / 360.0 + 4096.0 * 4, 2048.0);
+    gMe->angold = pSprite->ang = nAng;      // angold too, or playerMove adds the turn again
+    gMe->q16ang = fix16_from_int(nAng);
+    gMe->q16horiz = fix16_from_float((float)(-gB3dWarpPos[4] * 2048.0 / 360.0));
+    xvel[pSprite->index] = yvel[pSprite->index] = zvel[pSprite->index] = 0;
+    POSTURE *pPosture = &gMe->pPosture[gMe->lifeMode][gMe->posture];
+    gMe->zView = pSprite->z - pPosture->eyeAboveZ;
+    gMe->zWeapon = pSprite->z - pPosture->weaponAboveZ;
+    viewBackupView(gMe->nPlayer);
+}
+
+static void B3dLoadViews(const char *path)
+{
+    FILE *f = fopen(path, "r");
+    if (!f)
+        ThrowError("Can't open %s", path);
+    char line[256];
+    while (gB3dViewCount < 1024 && fgets(line, sizeof(line), f))
+    {
+        double *v = gB3dViews[gB3dViewCount];
+        v[4] = 0;
+        v[5] = -1;
+        if (sscanf(line, "%lf %lf %lf %lf %lf %lf", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5]) >= 4)
+            gB3dViewCount++;
+    }
+    fclose(f);
+    if (gB3dViewCount == 0)
+        ThrowError("No views in %s", path);
+    memcpy(gB3dViewPos, gB3dViews[0], sizeof(gB3dViewPos));
+    gB3dView = true;
+    gB3dFreezeFx = true;
+    if (gB3dShotSeconds < 0)
+        gB3dShotSeconds = 2;
+}
 bool bQuickStart = false;
 bool bNoAutoLoad = false;
 
