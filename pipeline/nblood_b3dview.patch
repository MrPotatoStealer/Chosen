+    { "b3dwarp", 93, 1 },
+    { "b3dsend", 94, 1 },
     { NULL, 0, 0 }
 };
 
@@ -1569,6 +1662,48 @@ void ParseOptions(void)
             break;
         case 43: // conf, noconsole
             break;
+        case 90:
+            if (OptArgc < 1)
+                ThrowError("Missing argument");
+            // "v" first: a negative x would read as the next switch
+            if (sscanf(OptArgv[0] + (OptArgv[0][0] == 'v'), "%lf,%lf,%lf,%lf,%lf", &gB3dViewPos[0], &gB3dViewPos[1], &gB3dViewPos[2], &gB3dViewPos[3], &gB3dViewPos[4]) >= 4)
+                gB3dView = true;
+            bQuickStart = 1;      // comparison runs skip the intro movies
+            break;
+        case 91:
+            if (OptArgc < 1)
+                ThrowError("Missing argument");
+            gB3dShotSeconds = atof(OptArgv[0]);
+            break;
+        case 92:
+            if (OptArgc < 1)
+                ThrowError("Missing argument");
+            B3dLoadViews(OptArgv[0]);
+            bQuickStart = 1;
+            break;
+        case 94:
+        {
+            if (OptArgc < 1)
+                ThrowError("Missing argument");
+            const char *p = OptArgv[0];
+            while (*p && gB3dSendCount < 16)
+            {
+                gB3dSend[gB3dSendCount++] = *p == 'c' ? 0x10000 | atoi(p + 1) : *p == 'o' ? 0x20000 | atoi(p + 1) : atoi(p);
+                while (*p && *p != ',')
+                    p++;
+                if (*p == ',')
+                    p++;
+            }
+            break;
+        }
+        case 93:
+            if (OptArgc < 1)
+                ThrowError("Missing argument");
+            // "v" first, as -b3dview
+            if (sscanf(OptArgv[0] + (OptArgv[0][0] == 'v'), "%lf,%lf,%lf,%lf,%lf,%lf", &gB3dWarpPos[0], &gB3dWarpPos[1], &gB3dWarpPos[2], &gB3dWarpPos[3], &gB3dWarpPos[4], &gB3dWarpPos[5]) >= 4)
+                gB3dWarp = true;
+            bQuickStart = 1;
+            break;
         case 44:
             if (OptArgc < 1)
                 ThrowError("Missing argument");
@@ -1956,8 +2091,51 @@ RESTART:
                 netCheckSync();
                 if (bDraw)
                 {
+                    if (gB3dSendCount && gGameStarted)
+                    {
+                        for (int i = 0; i < gB3dSendCount; i++)
+                        {
+                            int n = gB3dSend[i];
+                            if (n & 0x10000)
+                                evSend(0, 0, n & 0xffff, kCmdToggle, kCauserGame);
+                            else if ((n & 0x20000) && (n & 0xffff) < numsectors && sector[n & 0xffff].extra > 0)
+                                trTriggerSector(n & 0xffff, &xsector[sector[n & 0xffff].extra], kCmdOff, kCauserGame);
+                            else if (n >= 0 && n < numsectors && sector[n].extra > 0)
+                                trTriggerSector(n, &xsector[sector[n].extra], kCmdOn, kCauserGame);
+                        }
+                        gB3dSendCount = 0;
+                    }
+                    if (gB3dWarp && gGameStarted && gMe && gMe->pSprite)
+                    {
+                        gB3dWarp = false;
+                        B3dWarpPlayer();
+                    }
                     viewDrawScreen();
                     g_gameUpdateAndDrawTime = timerGetFractionalTicks() - gameUpdateStartTime;
+                    // Blood3D comparison mode: the screenshot once the level has run long enough, then quit
+                    if (gB3dShotSeconds >= 0 && gGameStarted)
+                    {
+                        if (gB3dStartClock < 0)
+                            gB3dStartClock = totalclock;
+                        if (gB3dSettle > 0)
+                            gB3dSettle--;      // a view list: drawn a few times from the new camera first
+                        else if ((totalclock - gB3dStartClock) >= gB3dShotSeconds * 120)
+                        {
+                            if (gB3dViewCount > 0)
+                                gB3dHold = true;
+                            videoCaptureScreen("b3dv0000.tga", 0);
+                            if (++gB3dViewIndex < gB3dViewCount)
+                            {
+                                memcpy(gB3dViewPos, gB3dViews[gB3dViewIndex], sizeof(gB3dViewPos));
+                                gB3dSettle = 3;
+                            }
+                            else
+                            {
+                                gB3dShotSeconds = -1;
+                                gQuitGame = true;
+                            }
+                        }
+                    }
                 }
             }
         }
