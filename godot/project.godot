; Engine configuration file.
; Chosen (Blood in Godot): Blood's levels from their .MAP files (Build data), gameplay in C#.

config_version=5

[application]

config/name="Chosen"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/project_settings_override="user://driver.cfg"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[debug]

file_logging/max_log_files=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/no_focus=true

[dotnet]

project/assembly_name="Chosen"

[rendering]

rendering_device/driver.windows="d3d12"
rendering_device/d3d12/max_resource_descriptors=262144
limits/global_shader_variables/buffer_size=524288
textures/canvas_textures/default_texture_filter=0
occlusion_culling/use_occlusion_culling=true

[shader_globals]

hdr_linear_screen={
"type": "float",
"value": 0.0
}
